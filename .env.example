# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Postgres connection string.
# Local: printed by `pnpm db:start` (Stramin uses port 55322, see supabase/config.toml).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Supabase (Auth). Local values are printed by `pnpm db:start`; cloud values are in the Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to true once Google login is configured in Supabase (ADR 0004).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Strava API (strava.com/settings/api). Keep the secret secret.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Garmin Connect Developer Program (from the Garmin developer portal). Keep secret.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=https://stramin.vercel.app/api/garmin/callback
